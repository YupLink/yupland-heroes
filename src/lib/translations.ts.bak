  "wdocs.param_allowance": { ru: "Лимит yocto-NEAR на gas-cost этого ключа. Без лимита по умолчанию", en: "yocto-NEAR limit for this key's gas cost. No limit by default" },
  "wdocs.param_app_name": { ru: "Имя dApp'а для отображения в approve-UI", en: "dApp name shown in the approve UI" },
