  "wdocs.param_contract_id": { ru: "ID контракта для FCAK (ограниченный ключ). Если не задан → FullAccess (опасно, юзер получит большое предупреждение)", en: "Contract ID for an FCAK (restricted key). If unset → FullAccess (dangerous, the user gets a big warning)" },
