  "wdocs.security_item_1": { ru: "· Юзер всегда видит approve-UI на нашем домене. Никаких silent действий.", en: "· The user always sees the approve UI on our domain. No silent actions." },
  "wdocs.security_item_2_before": { ru: "По умолчанию выдаётся", en: "By default we issue an" },
  "wdocs.security_item_2_after": { ru: "(function-call access key) с ограничением по контракту + опц. methods + опц. allowance. Просить FullAccess только если действительно нужно.", en: "(function-call access key) restricted to the contract + optional methods + optional allowance. Request FullAccess only if truly needed." },
  "wdocs.security_item_3_before": { ru: "Юзер может отозвать доступ в любой момент через", en: "The user can revoke access at any time via" },
  "wdocs.security_item_3_after": { ru: "Подключённые dApp'ы.", en: "Connected dApps." },
  "wdocs.security_item_4_before": { ru: "Origin запроса берётся из", en: "The request origin is taken from" },
  "wdocs.security_item_4_after": { ru: ", отображается юзеру и сохраняется в БД.", en: ", shown to the user and stored in the DB." },
